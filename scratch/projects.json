      {
        "id": "6b9f9091-1d4c-40c8-b1bb-91733cbbf93c",
        "project_id": "a959ad20-7411-456a-9a5a-02fb6512b88d",
        "type": "ResearchInsights",
        "content": {
          "intro": "To understand the reality of the harvest, we analyzed the physical toll of traditional methods in Mithilanchal.",
          "heading": "05. OBSERVATIONAL RESEARCH",
          "insights": [
            {
              "title": "Ergonomic Hazard",
              "number": "01",
              "description": "Prolonged prone and bent postures result in a 78% rate of chronic lower back pain among harvesters."
            },
            {
              "title": "Zero Protection",
              "number": "02",
              "description": "Workers handle the thorny aquatic plants bare-handed, suffering daily puncture wounds and infections."
            },
            {
              "title": "Extreme Inefficiency",
              "number": "03",
              "description": "Despite the grueling physical effort, productivity stagnates at 3.8-4.0 kg/hour, leaving nearly 25% of seeds uncollected."
            }
          ],
          "opportunityText": "We cannot automate this entirely for small-scale farmers—but we can completely eliminate the postural stress and manual sweeping.",
          "opportunityPrefix": "The insight:"
        },
        "order_index": 6,
        "created_at": "2026-09-02T13:27:21.881364+00:00",
        "updated_at": "2026-09-02T13:27:21.881364+00:00"
      },
      {
        "id": "dcf6a30d-8056-4565-92d8-ecd1c387cc45",
        "project_id": "a959ad20-7411-456a-9a5a-02fb6512b88d",
        "type": "Persona",
        "content": {
          "personas": [
            {
              "bio": "38 years old • 22 years experience • Mallah Community",
              "name": "Rajesh",
              "role": "Makhana Seed Harvester",
              "goals": [
                "Reduced physical strain and back pain",
                "Better safety from thorns and infections",
                "Higher hourly productivity to boost earnings"
              ],
              "quote": "I'm proud of what I do, but my body hurts. I want my children educated, but I hope they can stay in this work with better tools.",
              "frustrations": [
                "Chronic pain in lower back, neck, and wrists",
                "Economic exploitation by intermediaries",
                "Fear of permanent disability from daily injuries"
              ]
            }
          ]
        },
        "order_index": 7,
        "created_at": "2026-09-02T13:27:21.881364+00:00",
        "updated_at": "2026-09-02T13:27:21.881364+00:00"
      },
      {
        "id": "ccfba138-b0f2-4331-a83c-afe695292cd3",
        "project_id": "a959ad20-7411-456a-9a5a-02fb6512b88d",
        "type": "SWOT",
        "content": {
          "threats": [
            "Resentment that his destroyed body earns so little of the product value.",
            "Skilled at difficult ancestral work but ashamed young people view this as low-status.",
            "Fears occupation will disappear entirely as younger generation abandons it."
          ],
          "strengths": [
            "“My hands are covered in thorn marks and my whole body hurts.”",
            "“These tools haven't changed in generations - without hands, we cannot harvest.”",
            "“There must be a better way to do this - if someone designed something, I'd use it.”"
          ],
          "weaknesses": [
            "“This is my family's occupation, but the suffering makes me wonder if my children will do this.”",
            "“I'm earning only 12-25% of the retail value while farmers get rich.”",
            "“Machines exist but cost Rs 1-3 lakh - we can't afford them.”"
          ],
          "opportunities": [
            "Submerges in murky pond water 6-8 hours daily in bent-over, prone positions.",
            "Uses bamboo sieves to separate seeds from mud through vigorous shaking, repeating 50-100 times.",
            "Applies traditional medicinal oils nightly to treat daily puncture wounds."
          ]
        },
        "order_index": 8,
        "created_at": "2026-09-02T13:27:21.881364+00:00",
