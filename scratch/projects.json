      {
        "id": "06835669-d3d3-4a87-9793-d0264e1b2c11",
        "project_id": "df15c2fd-1a6a-4a50-8612-2e85c818cc49",
        "type": "GapAnalysis",
        "content": {
          "heading": "THE PROBLEM",
          "gapTitle": "The gap",
          "leftItems": [
            "Classroom",
            "Static / theoretical",
